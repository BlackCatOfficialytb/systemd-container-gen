# syntax=docker/dockerfile:1

# Rendered by scripts/check_and_render.py. The upstream tag stays unpinned so
# each digest-triggered rebuild picks up the latest Fedora updates.
# hadolint ignore=DL3007
FROM {{BASE_IMAGE}}:{{BASE_TAG}}

LABEL org.opencontainers.image.title="fedora-systemd" \
      org.opencontainers.image.description="Minimal Fedora image with systemd as PID 1" \
      org.opencontainers.image.source="https://github.com/BlackCatOfficialytb/systemd-container-gen" \
      org.opencontainers.image.version="{{BASE_TAG}}" \
      org.opencontainers.image.licenses="Apache-2.0"

# Install systemd without weak dependencies and remove all dnf metadata in the
# same layer. dnf keeps separate cache roots on newer Fedora releases, so clean
# both locations. Versions intentionally follow the selected upstream release.
# hadolint ignore=DL3041
RUN dnf -y --setopt=install_weak_deps=False install systemd \
    && dnf clean all \
    && rm -rf /var/cache/dnf /var/cache/libdnf5

# These units assume a full host boot and commonly fail or hang in containers.
# Mask them, select the headless target, and make every container generate its
# own machine ID.
RUN systemctl mask \
        systemd-remount-fs.service \
        sys-fs-fuse-connections.mount \
    && systemctl set-default multi-user.target \
    && rm -f /var/lib/dbus/machine-id \
    && : > /etc/machine-id

VOLUME [ "/sys/fs/cgroup" ]
STOPSIGNAL SIGRTMIN+3

CMD [ "/usr/lib/systemd/systemd" ]
