# syntax=docker/dockerfile:1

# Rendered by scripts/check_and_render.py. The upstream tag stays unpinned so
# each digest-triggered rebuild picks up the latest Debian security updates.
# hadolint ignore=DL3007
FROM {{BASE_IMAGE}}:{{BASE_TAG}}

LABEL org.opencontainers.image.title="debian-systemd" \
      org.opencontainers.image.description="Minimal Debian image with systemd as PID 1" \
      org.opencontainers.image.source="https://github.com/BlackCatOfficialytb/systemd-container-gen" \
      org.opencontainers.image.version="{{BASE_TAG}}" \
      org.opencontainers.image.licenses="Apache-2.0"

ARG DEBIAN_FRONTEND=noninteractive

# install only the minimal systemd userspace and discard package metadata.
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        systemd \
        systemd-sysv \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Remove getty/console activation links and mask the virtual-console units so
# this headless image does not spend time starting unusable consoles. Empty the
# machine ID so every container generates a unique one on first boot.
RUN find /etc/systemd/system -type l \
        \( -name 'getty.target' \
           -o -name 'console-getty.service' \
           -o -name 'getty@*.service' \
           -o -name 'serial-getty@*.service' \) \
        -delete \
    && systemctl mask console-getty.service getty.target \
    && systemctl set-default multi-user.target \
    && rm -f /var/lib/dbus/machine-id \
    && : > /etc/machine-id

VOLUME [ "/sys/fs/cgroup" ]
STOPSIGNAL SIGRTMIN+3

CMD [ "/sbin/init" ]
